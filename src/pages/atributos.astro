---
import { HeroSlider1, BannerPrincipal, FondoBotellas, FondoDrinkers2 } from "@static/images";
import Layout from "../layouts/Layout.astro";
import { Nosotros as NosotrosModule } from "@modules/Nosotros";
import { Contact as ContactModule } from "@modules/Contact";
import { Hero } from "@modules/Hero";
import Footer from "../components/organisms/Footer.astro";
import WAButton from "@components/banners/ButtonWhatsapp.astro";
import Outro from "@components/organisms/Outro.astro";
import FeaturedProducts from "@components/organisms/FeaturedProducts.astro";
---

<Layout
  title="Legion Drinkers | Qualities"
  description="Compra los mejores vinos, licores y destilados en México."
>
  <main class="page-content">
    <Hero
      heroType="ParallaxImage"
      client:load
      data={{
        image: FondoDrinkers2.src,
        content: {
          title: "Qualities",
          paragraph:
            "Explora nuestra amplia selección de bebidas divididas en categorías para que encuentres fácilmente lo que buscas. Desde destilados y licores hasta vinos y cervezas, tenemos algo para cada ocasión y preferencia. ¡Descubre tu favorita!",
        },
      }}
    />

    <Hero
      heroType="textImage"
      client:visible
      data={{
        switchPlaces: false,
        image: {
          src: "assets/branding/Precio-mayoreoV3.webp",
          width: 900,
          height: 800,
          alt: "Catalogo Legion Drinkers",
        },
        title: "¡Lleva más, paga menos con nuestro Mayoreo!",
        paragraph:
          "Aprovecha precios increíbles en <strong>3 piezas iguales</strong> o <strong>4 piezas combinadas</strong> de tus botellas favoritas. ¡Descubre nuestro catálogo completo en <strong>Legión Drinkers</strong>, encuentra lo que buscas y lleva la celebración al siguiente nivel!", // Sección Mayoreo
        buttons: [
          {
            link: "catalogo/catalogo-legion-drinkers.pdf", // Enlace dinámico
            text: "Descargar Catálogo Completo", // Texto del botón
            variant: "secondary", // Variación del botón, si es necesario
          },
        ],
      }}
    />

    <Hero
      heroType="textImage"
      client:visible
      data={{
        switchPlaces: false,
        image: {
          src: "assets/branding/paquetesCaja.webp",
          width: 700,
          height: 500,
          alt: "Paquetes de Mayoreo Legion Drinkers",
        },
        title: "¿Cuántos invitados van a tu fiesta?",
        paragraph:
          "Arma tu <strong>Media Caja (6 botellas)</strong> ideal para 25 invitados o sube a una <strong>Caja Completa (12 botellas)</strong> para 50 invitados. ¡En <strong>Legión Drinkers</strong> armas tus paquetes como quieras para tus cumpleaños, carnes asadas o eventos!",
        buttons: [
          {
            link: "catalogo/catalogo-legion-drinkers.pdf",
            text: "Descargar Catálogo de Mayoreo",
            variant: "secondary",
          },
        ],
      }}
    />

    <Hero
      heroType="textImage"
      client:visible
      data={{
        switchPlaces: false,
        image: {
          src: "assets/branding/Botellas-Frias.jpg",
          width: 700,
          height: 500,
          alt: "Botellas frías - Legion Drinkers",
        },
        title: "Botellas frías, más suave, mejor sabor",
        paragraph:
          "Disfruta de tus bebidas favoritas a la temperatura ideal. Con nuestra selección de botellas frías, el sabor y la suavidad se potencian para que disfrutes al máximo cada momento. ¡Haz tu pedido ahora y brinda con calidad!",
      }}
    />

    <FeaturedProducts />

    <!-- <ContactModule client:load /> -->

    <!-- <NosotrosModule client:load /> -->
    <!-- <Outro /> -->
  </main>

  <WAButton url="https://wa.link/8or624" />

  <Footer />
</Layout>
